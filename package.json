{
  "name": "nba-draft-assistant",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-ts.cjs tests/run.ts",
    "test:e2e": "playwright test",
    "import-players": "node scripts/run-ts.cjs scripts/import-players.ts",
    "validate-players": "node scripts/run-ts.cjs scripts/validate-players.ts",
    "format:check": "prettier --check src scripts tests docs README.md *.ts *.mjs *.json",
    "postbuild": "node scripts/build-sw.mjs",
    "preview-players": "node scripts/run-ts.cjs scripts/preview-players.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.48.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "xlsx": "0.18.5",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9"
  }
}
